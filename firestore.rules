rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdminEmail() {
      return request.auth.token.email is string
        && request.auth.token.email.matches("(?i)^justbegabs@gmail\\.com$");
    }

    function isAdminUid() {
      return request.auth.uid in [
        // Opcional: adicione UIDs admins aqui para não depender apenas de e-mail.
      ];
    }

    function isAdmin() {
      return request.auth != null
        && (isAdminEmail() || isAdminUid());
    }

    match /users/{userId}/characters/{characterId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /cmsContent/{section}/items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /cmsContent/informacoes/items/{itemId}/subitems/{subId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
